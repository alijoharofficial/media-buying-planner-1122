# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: Google Analytics 4. Loaded only after cookie consent.
NEXT_PUBLIC_GA_ID=

# Contact form: Cloudflare Turnstile (required in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact form email delivery via Resend (required in production)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
